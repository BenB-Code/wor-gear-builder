const AP = { mains:new Set(), sets:new Set() };
function renderAddPanel(){
  document.getElementById("ap-mains").innerHTML = ALLSTATS.map(a=>
    `<button type="button" class="chip ${STAT[a]} pick${AP.mains.has(a)?' sel':''}" data-role="ap-main" data-stat="${a}">${a}</button>`).join("");
  for(const side of ["right","left"]){
    document.getElementById("ap-sets-"+side).innerHTML = SIDE_SETS[side].map(n=>
      `<button type="button" class="chip set t${SETTIER[n]} pick${AP.sets.has(n)?' sel':''}" data-role="ap-set" data-set="${esc(n)}">${esc(n)}</button>`).join("");
  }
}
function openDlg(){
  AP.mains.clear(); AP.sets.clear();
  document.getElementById("ap-name").value = "";
  document.getElementById("ap-section").value = UI.fSection!=="all" ? UI.fSection : "right";
  document.getElementById("ap-warn").textContent = "";
  renderAddPanel();
  document.getElementById("dlg-overlay").hidden = false;
  document.getElementById("ap-name").focus();
}
function closeDlg(){ document.getElementById("dlg-overlay").hidden = true; }
function createRule(){
  if(AP.sets.size === 0){ document.getElementById("ap-warn").textContent = "choisis au moins un set"; return; }
  while(getRule("P"+customSeq)) customSeq++;
  const id = "P"+customSeq++;
  const name = document.getElementById("ap-name").value.trim() || ("Règle "+id);
  const section = document.getElementById("ap-section").value;
  CUSTOM.push({ id, name, section, sets:sortSets([...AP.sets]), mains:sortStats([...AP.mains]), arch:[] });
  S[id] = { pool:[], ess:[], req:3 };
  closeDlg();
  UI.seg = "perso"; UI.q=""; UI.fSection="all"; UI.fArch="all";
  UI.open.add(id); UI.pending = id;
  if(UI.view!=="regles"){ goto("/regles/"+id); } else { renderView(); }
  scheduleSave();
  toast(`Règle <b>${id}</b> créée — règle son pool et son requis sur la carte.`);
}

/* ══════════════ INTERACTIONS ══════════════ */
function armed(btn, label){
  if(btn.classList.contains("arm")) return true;
  btn.classList.add("arm");
  const prev = btn.textContent;
  btn.textContent = label;
  setTimeout(()=>{ btn.classList.remove("arm"); btn.textContent = prev; }, 3000);
  return false;
}
document.addEventListener("click", e=>{
  const t = e.target;

  // navigation
  const nav = t.closest(".nav-btn");
  if(nav){ goto("/"+nav.dataset.nav); return; }
  const ref = t.closest("[data-goto]");
  if(ref){ goto("/regles/"+ref.dataset.goto); return; }

  // segmented + filtres
  const seg = t.closest("[data-seg]");
  if(seg){ UI.seg = seg.dataset.seg;
    document.querySelectorAll("[data-seg]").forEach(b=>b.classList.toggle("on", b===seg));
    updateRuleList(); return; }
  const fs = t.closest("[data-fsection]");
  if(fs){ UI.fSection = fs.dataset.fsection;
    document.querySelectorAll("[data-fsection]").forEach(b=>b.classList.toggle("on", b===fs));
    updateRuleList(); return; }
  const fa = t.closest("[data-farch]");
  if(fa){ UI.fArch = fa.dataset.farch;
    document.querySelectorAll("[data-farch]").forEach(b=>b.classList.toggle("on", b===fa));
    updateRuleList(); return; }
  const ft = t.closest("[data-ftier]");
  if(ft){ UI.setsTier = ft.dataset.ftier;
    document.querySelectorAll("[data-ftier]").forEach(b=>b.classList.toggle("on", b===ft));
    updateSetsTables(); return; }

  // toolbar
  if(t.closest("#add-open") || t.closest("#add-open-empty")){ openDlg(); return; }
  const ca = t.closest("#copy-all");
  if(ca){
    const parts = [];
    for(const sec of SECTIONS){
      const list = activeList(sec);
      if(!list.length) continue;
      parts.push("══ "+SECTION_LABEL[sec].toUpperCase()+" ══");
      list.forEach(r=>parts.push(copyText(r)));
    }
    doCopy(parts.join("\n\n"), ca); return;
  }
  const ta2 = t.closest("#toggle-all");
  if(ta2){
    if(UI.open.size){ UI.open.clear(); } else { activeAll().forEach(r=>UI.open.add(r.id)); }
    updateRuleList(); return;
  }
  const ra = t.closest("#reset-all");
  if(ra){
    if(!armed(ra, "sûr ? tout revient aux défauts")) return;
    S = JSON.parse(JSON.stringify(DEFAULTS));
    DELETED = new Set(); CUSTOM = []; ENTERED = new Set();
    UI.open.clear();
    renderView(); scheduleSave();
    toast("Tout est revenu aux défauts.");
    return;
  }

  // dialogue
  if(t.closest("#ap-cancel")){ closeDlg(); return; }
  if(t.closest("#ap-create")){ createRule(); return; }
  if(t.id === "dlg-overlay"){ closeDlg(); return; }
  const apm = t.closest('[data-role="ap-main"]');
  if(apm){ AP.mains.has(apm.dataset.stat) ? AP.mains.delete(apm.dataset.stat) : AP.mains.add(apm.dataset.stat); renderAddPanel(); return; }
  const aps = t.closest('[data-role="ap-set"]');
  if(aps){ AP.sets.has(aps.dataset.set) ? AP.sets.delete(aps.dataset.set) : AP.sets.add(aps.dataset.set); renderAddPanel(); return; }

  // export pdf (sidebar)
  if(t.closest("#export-pdf")){
    document.getElementById("print-view").innerHTML = printDoc();
    toast("Boîte d'impression ouverte — choisis « Enregistrer en PDF ». Si rien ne s'ouvre, ouvre le fichier dans ton navigateur.", {ttl:7000});
    try{ window.print(); }catch(_){}
    return;
  }

  // cartes de règles
  const tog = t.closest(".tog");
  if(tog){
    const id=tog.dataset.rule, a=tog.dataset.stat, st=S[id];
    if(st.ess.includes(a)){ st.ess=st.ess.filter(x=>x!==a); st.pool=st.pool.filter(x=>x!==a); }
    else if(st.pool.includes(a)){ st.ess=[...st.ess,a]; }
    else { st.pool=[...st.pool,a]; }
    st.pool=sortStats(st.pool); st.ess=sortStats(st.ess);
    rerenderRule(id); scheduleSave(); return;
  }
  const minus = t.closest(".st-minus"), plus = t.closest(".st-plus");
  if(minus||plus){
    const id=(minus||plus).dataset.rule, st=S[id];
    st.req = Math.min(4, Math.max(1, st.req + (plus?1:-1)));
    rerenderRule(id); scheduleSave(); return;
  }
  const rst = t.closest(".rc-reset");
  if(rst){
    const id=rst.dataset.rule;
    S[id] = JSON.parse(JSON.stringify(DEFAULTS[id]));
    rerenderRule(id); scheduleSave(); return;
  }
  const cp = t.closest(".rc-copy");
  if(cp){ doCopy(copyText(getRule(cp.dataset.rule)), cp); return; }
  const del = t.closest(".rc-del");
  if(del){
    const id = del.dataset.rule;
    if(isCustom(id)){
      const idx = CUSTOM.findIndex(r=>r.id===id);
      const snapRule = CUSTOM[idx], snapState = S[id];
      CUSTOM.splice(idx,1); delete S[id];
      UI.open.delete(id);
      updateRuleList(); updateSidebar(); scheduleSave();
      toast(`Règle perso <b>${id}</b> supprimée.`, {action:{label:"annuler", fn(){
        CUSTOM.splice(Math.min(idx, CUSTOM.length), 0, snapRule); S[id]=snapState;
        updateRuleList(); updateSidebar(); scheduleSave();
      }}});
    } else {
      DELETED.add(id);
      UI.open.delete(id);
      updateRuleList(); updateSidebar(); scheduleSave();
      toast(`Règle <b>${id}</b> supprimée — restaurable en bas de liste.`, {action:{label:"annuler", fn(){
        DELETED.delete(id);
        updateRuleList(); updateSidebar(); scheduleSave();
      }}});
    }
    return;
  }
  const rest = t.closest(".restore");
  if(rest){ DELETED.delete(rest.dataset.rule); updateRuleList(); updateSidebar(); scheduleSave(); return; }

  // repli/dépli d'une carte (après tous les contrôles internes)
  const head = t.closest(".row-head");
  if(head && !t.closest("input")){
    const id = head.dataset.toggle;
    UI.open.has(id) ? UI.open.delete(id) : UI.open.add(id);
    rerenderRule(id);
    const tg = document.getElementById("toggle-all");
    if(tg) tg.textContent = UI.open.size ? "Tout replier" : "Tout déplier";
    return;
  }
});
