    if(q){ e.preventDefault(); q.focus(); }
  }
  const head = e.target.closest && e.target.closest(".row-head");
  if(head && (e.key===" "||e.key==="Enter") && !e.target.closest("input,button")){
    e.preventDefault();
    const id = head.dataset.toggle;
    UI.open.has(id) ? UI.open.delete(id) : UI.open.add(id);
    rerenderRule(id);
  }
});
window.addEventListener("hashchange", route);

/* ══════════════ DÉMARRAGE ══════════════ */
try{ if(!location.hash) history.replaceState(null,"","#/regles"); }catch(_){}
route();
restoreState();
</script>
