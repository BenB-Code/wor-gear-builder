function updateRuleList(){
  const el = document.getElementById("rule-list");
  if(!el) return;
  let html = "";
  if(UI.seg === "perso"){
    const list = CUSTOM.filter(matchFilters);
    if(!CUSTOM.length){
      html = `<div class="empty"><p>Aucune règle personnalisée pour l'instant.<br>Les règles créées ici vivent à part des ${BUILTIN.length} prédéfinies — supprimables sans filet, exportées et sauvegardées comme les autres.</p>
        <button type="button" class="btn primary" id="add-open-empty">＋ Créer ta première règle</button></div>`;
    } else if(!list.length){
      html = `<div class="empty"><p>Aucune règle personnalisée ne correspond aux filtres.</p></div>`;
    } else {
      for(const sec of SECTIONS){
        const rows = list.filter(r=>r.section===sec);
        if(!rows.length) continue;
        html += `<h3 class="grp-head">${SECTION_LABEL[sec]} <span class="n">${rows.length}</span></h3>` + rows.map(ruleRow).join("");
      }
    }
  } else {
    const list = BUILTIN.filter(r=>!DELETED.has(r.id)).filter(matchFilters);
    if(!list.length){
      html = `<div class="empty"><p>Aucune règle ne correspond aux filtres.</p></div>`;
    } else {
      for(const sec of SECTIONS){
        const rows = list.filter(r=>sectionOf(r.id)===sec);
        if(!rows.length) continue;
        html += `<h3 class="grp-head">${SECTION_LABEL[sec]} <span class="n">${rows.length}</span></h3>` + rows.map(ruleRow).join("");
      }
    }
    const dels = BUILTIN.filter(r=>DELETED.has(r.id));
    if(dels.length){
      html += `<div class="deleted-line">Supprimées : ${dels.map(r=>`<button type="button" class="restore" data-rule="${r.id}">${r.id} — restaurer</button>`).join(" · ")}</div>`;
    }
  }
  el.innerHTML = html;
  const tg = document.getElementById("toggle-all");
  if(tg) tg.textContent = UI.open.size ? "Tout replier" : "Tout déplier";
}
function rerenderRule(id){
  const el = document.getElementById("card-"+id);
  if(!el){ updateRuleList(); return; }
  const r = getRule(id);
  if(!r){ updateRuleList(); return; }
  el.outerHTML = ruleRow(r);
}

