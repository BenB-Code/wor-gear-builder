<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tri d'équipement · Watcher of Realms</title>
<!--
  Watcher of Realms — gestionnaire de règles de tri d'équipement
  Single-page app autonome : aucune dépendance, aucun réseau, données 100 % locales.
  Persistance : window.storage (environnement Claude). Pour une publication hors Claude,
  remplacer les appels window.storage.get/set (fonctions persist/restore) par localStorage.
-->
<style>
  :root{
    --bg:#14121a; --bg-side:#100e15; --panel:#1d1a24; --panel2:#262230;
    --border:#35303f; --border-soft:#2a2632;
    --ink:#ece7db; --muted:#9a92a6; --faint:#6f6880;
    --t3:#e2b04a; --t2:#a678e8; --t1:#5f9fd6; --t0:#7a7580;
    --off:#cf6054; --deff:#5f9fd6; --util:#6fbf8f;
    --gold-dim:rgba(226,176,74,.14); --radius:12px;
    --display:"Palatino Linotype","Iowan Old Style",Palatino,"Book Antiqua",Georgia,serif;
    --body:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
    --mono:ui-monospace,"SF Mono","Cascadia Code",Menlo,Consolas,monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  @media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important;scroll-behavior:auto!important}}
  html,body{height:100%}
  body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:15px;line-height:1.6}
  ::selection{background:rgba(226,176,74,.25)}
  button{font:inherit;color:inherit}

  /* ── Structure ── */
  .app{display:grid;grid-template-columns:242px 1fr;height:100vh}
  aside.side{background:var(--bg-side);border-right:1px solid var(--border-soft);display:flex;flex-direction:column;
    padding:18px 14px 14px;gap:6px;overflow-y:auto}
  main#view{overflow-y:auto;padding:26px 30px 90px;scroll-behavior:smooth;
    background-image:radial-gradient(ellipse 800px 380px at 55% -90px,rgba(226,176,74,.05),transparent)}
  .wrap{max-width:1060px;margin:0 auto}

  /* ── Sidebar ── */
  .brand{display:flex;align-items:center;gap:10px;padding:2px 8px 14px}
  .brand .diamond{color:var(--t3);font-size:17px}
  .brand h1{font-family:var(--display);font-variant:small-caps;letter-spacing:.05em;font-weight:600;font-size:17px;line-height:1.15}
  .brand .sub{color:var(--faint);font-size:11px;margin-top:1px}
  nav.mainnav{display:flex;flex-direction:column;gap:2px}
  .nav-btn{display:flex;align-items:center;gap:10px;appearance:none;background:none;border:none;border-left:2px solid transparent;
    color:var(--muted);font-family:var(--display);font-variant:small-caps;letter-spacing:.05em;font-size:15px;
    padding:9px 10px;border-radius:0 8px 8px 0;cursor:pointer;text-align:left;transition:color .15s,background .15s}
  .nav-btn svg{flex:0 0 auto;opacity:.75}
  .nav-btn:hover{color:var(--ink);background:rgba(255,255,255,.025)}
  .nav-btn.active{color:var(--t3);border-left-color:var(--t3);background:var(--gold-dim)}
  .nav-btn .count{margin-left:auto;font-family:var(--mono);font-size:10.5px;color:var(--faint);
    border:1px solid var(--border-soft);border-radius:10px;padding:0 7px}
  .nav-btn.active .count{color:var(--t3);border-color:rgba(226,176,74,.4)}
  .nav-btn:focus-visible{outline:2px solid var(--t3);outline-offset:-2px}
  .side-foot{margin-top:auto;display:flex;flex-direction:column;gap:10px;padding:14px 8px 2px;border-top:1px solid var(--border-soft)}
  .prog-label{display:flex;justify-content:space-between;align-items:baseline;font-size:11.5px;color:var(--muted)}
  .prog-label b{font-family:var(--mono);color:var(--t3);font-weight:600}
  .prog-bar{height:5px;border-radius:3px;background:var(--panel2);overflow:hidden}
  .prog-bar i{display:block;height:100%;background:linear-gradient(90deg,#b58a2e,var(--t3));border-radius:3px;transition:width .3s}
  .side-btn{appearance:none;background:var(--panel);border:1px solid var(--border);color:var(--muted);
    font-family:var(--mono);font-size:11.5px;padding:7px 10px;border-radius:8px;cursor:pointer;transition:all .15s;text-align:center}
  .side-btn:hover{color:var(--t3);border-color:rgba(226,176,74,.45)}
  .side-btn:focus-visible{outline:2px solid var(--t3);outline-offset:2px}
  .save-line{display:flex;align-items:center;gap:7px;color:var(--faint);font-size:10.5px;min-height:15px}
  .save-line .dot{width:6px;height:6px;border-radius:50%;background:var(--faint);flex:0 0 auto}
  .save-line.ok .dot{background:var(--util)}
  .save-line.warn .dot{background:var(--off)}

  /* ── En-tête de vue ── */
  .view-head{margin-bottom:14px}
  .view-head h2{font-family:var(--display);font-variant:small-caps;letter-spacing:.06em;font-weight:600;font-size:23px}
  .view-head .lede{color:var(--muted);font-size:13px;margin-top:3px;max-width:760px}
  h3.grp-head{font-family:var(--display);font-variant:small-caps;letter-spacing:.05em;font-weight:600;font-size:15.5px;
    color:var(--muted);margin:22px 0 8px;display:flex;align-items:center;gap:10px;position:sticky;top:-26px;
    background:var(--bg);padding:6px 0;z-index:5}
  h3.grp-head::after{content:"";flex:1;height:1px;background:linear-gradient(to right,var(--border),transparent)}
  h3.grp-head .n{font-family:var(--mono);font-size:11px;color:var(--faint)}

  /* ── Segmented + filtres + toolbar ── */
  .seg{display:inline-flex;background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:3px;gap:3px}
  .seg button{appearance:none;background:none;border:none;color:var(--muted);font-family:var(--display);font-variant:small-caps;
    letter-spacing:.04em;font-size:14.5px;padding:6px 16px;border-radius:7px;cursor:pointer;transition:all .15s}
  .seg button:hover{color:var(--ink)}
  .seg button.on{background:var(--gold-dim);color:var(--t3)}
  .seg button:focus-visible{outline:2px solid var(--t3);outline-offset:-2px}
  .seg button .n{font-family:var(--mono);font-size:10.5px;opacity:.8;margin-left:5px}
  .controls{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin:14px 0 4px}
  .search{position:relative;flex:1 1 220px;max-width:340px}
  .search input{width:100%;background:var(--panel);border:1px solid var(--border);border-radius:9px;color:var(--ink);
    padding:8px 12px 8px 32px;font:inherit;font-size:13.5px}
  .search input::placeholder{color:var(--faint)}
  .search svg{position:absolute;left:10px;top:50%;transform:translateY(-50%);opacity:.5}
  input:focus-visible,select:focus-visible{outline:2px solid var(--t3);outline-offset:1px}
  .fchips{display:flex;gap:5px;flex-wrap:wrap}
  .fchip{appearance:none;background:var(--panel);border:1px solid var(--border);color:var(--muted);
    font-family:var(--mono);font-size:11.5px;padding:5px 12px;border-radius:20px;cursor:pointer;transition:all .15s}
  .fchip:hover{color:var(--ink)}
  .fchip.on{color:var(--t3);border-color:rgba(226,176,74,.5);background:var(--gold-dim)}
  .fchip:focus-visible{outline:2px solid var(--t3);outline-offset:2px}
  .toolbar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:10px 0 2px}
  .btn{appearance:none;background:var(--panel);border:1px solid var(--border);color:var(--ink);
    font-family:var(--mono);font-size:12px;padding:7px 14px;border-radius:8px;cursor:pointer;transition:all .15s}
  .btn:hover{border-color:rgba(226,176,74,.5);color:var(--t3)}
  .btn:focus-visible{outline:2px solid var(--t3);outline-offset:2px}
  .btn.primary{background:var(--gold-dim);border-color:rgba(226,176,74,.5);color:var(--t3);font-weight:600}
  .btn.primary:hover{background:rgba(226,176,74,.22)}
  .btn.danger:hover{border-color:var(--off);color:var(--off)}
  .btn.arm{color:#fff!important;background:var(--off);border-color:var(--off)!important}
  .hint{color:var(--faint);font-size:12px;margin:8px 0 0}
  .hint b{color:var(--muted);font-weight:600}

  /* ── Lignes de règles ── */
  .rule-list{margin-top:4px}
  .rule{background:var(--panel);border:1px solid var(--border-soft);border-radius:var(--radius);
    border-left:3px solid var(--t3);margin:9px 0;transition:border-color .15s;overflow:hidden}
  .rule:hover{border-color:var(--border);border-left-color:var(--t3)}
  .rule.s-t1{border-left-color:var(--t1)}
  .rule.s-t1:hover{border-left-color:var(--t1)}
  .rule.perso{border-left-color:var(--t2)}
  .rule.perso:hover{border-left-color:var(--t2)}
  .rule.flash{animation:flash 1.6s ease}
  @keyframes flash{0%,60%{box-shadow:0 0 0 2px rgba(226,176,74,.65)}100%{box-shadow:none}}
  .row-head{display:flex;align-items:center;gap:11px;padding:11px 14px;cursor:pointer;flex-wrap:wrap}
  .row-head:focus-visible{outline:2px solid var(--t3);outline-offset:-2px}
  .chk{appearance:none;flex:0 0 auto;width:17px;height:17px;border:1.5px solid var(--faint);border-radius:5px;
    background:transparent;cursor:pointer;position:relative;transition:all .15s}
  .chk:hover{border-color:var(--t3)}
  .chk:checked{background:var(--t3);border-color:var(--t3)}
  .chk:checked::after{content:"✓";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    color:#1c1608;font-size:12px;font-weight:700}
  .chk:focus-visible{outline:2px solid var(--t3);outline-offset:2px}
  .rc-id{font-family:var(--mono);font-size:11px;font-weight:600;color:var(--t3);background:var(--gold-dim);
    border:1px solid rgba(226,176,74,.35);border-radius:5px;padding:2px 8px;flex:0 0 auto}
  .s-t1 .rc-id{color:#8fbde4;background:rgba(95,159,214,.1);border-color:rgba(95,159,214,.35)}
  .perso .rc-id{color:#c4a3f0;background:rgba(166,120,232,.12);border-color:rgba(166,120,232,.4)}
  .rc-name{font-family:var(--display);font-variant:small-caps;letter-spacing:.03em;font-size:16px;font-weight:600}
  .custom-tag{font-family:var(--mono);font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;color:#c4a3f0;
    border:1px solid rgba(166,120,232,.4);border-radius:4px;padding:1px 6px;margin-left:8px;vertical-align:2px}
  .mod-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--t3);margin-left:7px;vertical-align:1px}
  .row-mains{font-family:var(--mono);font-size:11.5px;color:var(--muted);margin-left:2px}
  .row-right{margin-left:auto;display:flex;align-items:center;gap:10px}
  .minis{display:flex;gap:3px}
  .mini{font-family:var(--mono);font-size:10px;padding:1px 6px;border-radius:4px;border:1px solid var(--border);color:var(--muted)}
  .mini.e{color:var(--t3);border-color:rgba(226,176,74,.4)}
  .dots{display:flex;gap:4px}
  .dot{width:10px;height:10px;border-radius:50%;border:1.5px solid var(--faint)}
  .dot.fill{background:var(--t3);border-color:var(--t3)}
  .s-t1 .dot.fill{background:var(--t1);border-color:var(--t1)}
  .perso .dot.fill{background:var(--t2);border-color:var(--t2)}
  .chev{flex:0 0 auto;transition:transform .2s;opacity:.55}
  .rule.open .chev{transform:rotate(180deg)}
  .row-body{display:none;padding:2px 16px 14px 45px;border-top:1px dashed var(--border-soft)}
  .rule.open .row-body{display:block}
  .rb-grid{display:grid;grid-template-columns:auto 1fr;gap:7px 16px;font-size:13.5px;margin-top:10px}
  .rb-grid .k{color:var(--faint);font-family:var(--display);font-variant:small-caps;letter-spacing:.04em;font-size:13px;white-space:nowrap;padding-top:2px}
  .chip{display:inline-block;font-family:var(--mono);font-size:11.5px;padding:2px 8px;border-radius:5px;
    border:1px solid var(--border);background:var(--panel2);color:var(--ink);margin:2px 3px 2px 0;white-space:nowrap}
  .chip.off{border-color:rgba(207,96,84,.5);color:#e8968c}
  .chip.deff{border-color:rgba(95,159,214,.5);color:#93c1e8}
  .chip.util{border-color:rgba(111,191,143,.5);color:#9ed9b4}
  .chip.set{font-family:var(--body);font-size:12px;background:transparent}
  .chip.set.t3{border-color:rgba(226,176,74,.55);color:var(--t3)}
  .chip.set.t2{border-color:rgba(166,120,232,.55);color:#c4a3f0}
  .chip.set.t1{border-color:rgba(95,159,214,.5);color:#8fbde4}
  .chip.set.t0{border-color:rgba(122,117,128,.45);color:var(--t0)}
  button.chip{cursor:pointer;transition:opacity .12s,border-color .12s,background .12s}
  button.chip:focus-visible{outline:2px solid var(--t3);outline-offset:2px}
  .chip.stateoff{opacity:.28;border-style:dashed;background:transparent}
  .chip.ess{border-width:1.5px;font-weight:700}
  .chip.ess.off{background:rgba(207,96,84,.14)}
  .chip.ess.deff{background:rgba(95,159,214,.14)}
  .chip.ess.util{background:rgba(111,191,143,.14)}
  .main-or{font-family:var(--mono);font-size:12px;color:var(--ink)}
  .main-or .sep{color:var(--faint);padding:0 4px}
  .stepper{display:inline-flex;align-items:center;gap:2px;border:1px solid var(--border);border-radius:6px;background:var(--panel2);vertical-align:middle}
  .stepper button{appearance:none;background:none;border:none;color:var(--muted);font-family:var(--mono);font-size:14px;
    width:24px;height:24px;cursor:pointer;line-height:1}
  .stepper button:hover{color:var(--t3)}
  .stepper button:focus-visible{outline:2px solid var(--t3);outline-offset:-2px;border-radius:4px}
  .stepper .val{font-family:var(--mono);font-size:13px;color:var(--ink);min-width:16px;text-align:center}
  .rc-warn{color:var(--off);font-family:var(--mono);font-size:11px;margin-left:8px}
  .rb-note{margin-top:12px;padding-top:10px;border-top:1px dashed var(--border-soft);color:var(--muted);font-size:12.5px}
  .rb-actions{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}
  .sbtn{appearance:none;background:var(--panel2);border:1px solid var(--border);color:var(--muted);font-family:var(--mono);
    font-size:11px;padding:4px 11px;border-radius:6px;cursor:pointer;transition:all .15s}
  .sbtn:hover{color:var(--t3);border-color:rgba(226,176,74,.4)}
  .sbtn:focus-visible{outline:2px solid var(--t3);outline-offset:2px}
  .sbtn.ok{color:var(--util);border-color:rgba(111,191,143,.5)}
  .sbtn.del:hover{color:var(--off);border-color:rgba(207,96,84,.4)}
  .deleted-line{color:var(--faint);font-size:12px;margin:10px 0;font-family:var(--mono)}
  .deleted-line button{appearance:none;background:none;border:none;color:var(--t1);cursor:pointer;font:inherit;
    text-decoration:underline dotted;padding:0}
  .deleted-line button:focus-visible{outline:2px solid var(--t3);outline-offset:2px}
  .empty{border:1px dashed var(--border);border-radius:var(--radius);padding:38px 20px;text-align:center;color:var(--muted);margin:18px 0}
  .empty p{margin-bottom:14px;font-size:13.5px}

  /* ── Panneaux, tables, référence ── */
  .panel{background:var(--panel);border:1px solid var(--border-soft);border-radius:var(--radius);padding:18px 20px;margin:14px 0}
  .panel.note{border-left:3px solid var(--t3);background:linear-gradient(to right,var(--gold-dim),var(--panel) 55%)}
  .panel h4{font-family:var(--display);font-variant:small-caps;letter-spacing:.05em;font-size:16px;font-weight:600;margin-bottom:8px}
  table{width:100%;border-collapse:collapse;font-size:13.5px;margin:8px 0}
  th{font-family:var(--display);font-variant:small-caps;letter-spacing:.04em;font-weight:600;text-align:left;
    color:var(--muted);padding:8px 10px;border-bottom:1px solid var(--border);white-space:nowrap}
  td{padding:8px 10px;border-bottom:1px solid var(--border-soft);vertical-align:top}
  tr:hover td{background:rgba(255,255,255,.015)}
  .tbl-wrap{overflow-x:auto}
  .tier-badge{display:inline-block;font-family:var(--mono);font-size:11px;font-weight:600;padding:1px 8px;border-radius:4px}
  .tier-badge.b3{background:rgba(226,176,74,.15);color:var(--t3);border:1px solid rgba(226,176,74,.4)}
  .tier-badge.b2{background:rgba(166,120,232,.13);color:#c4a3f0;border:1px solid rgba(166,120,232,.4)}
  .tier-badge.b1{background:rgba(95,159,214,.12);color:#8fbde4;border:1px solid rgba(95,159,214,.4)}
  .tier-badge.b0{background:rgba(122,117,128,.12);color:var(--t0);border:1px solid rgba(122,117,128,.4)}
  .dest{font-size:12.5px}
  .ruleref{appearance:none;cursor:pointer;font-family:var(--mono);font-size:11px;color:var(--t3);background:var(--gold-dim);
    border:1px solid rgba(226,176,74,.3);border-radius:4px;padding:1px 6px;margin:1px 4px 1px 0;white-space:nowrap;transition:all .15s}
  .ruleref.t1r{color:#8fbde4;background:rgba(95,159,214,.1);border-color:rgba(95,159,214,.3)}
  .ruleref:hover{border-color:var(--t3);text-decoration:underline}
  .ruleref.t1r:hover{border-color:var(--t1)}
  .ruleref:focus-visible{outline:2px solid var(--t3);outline-offset:2px}
  .recycle{color:var(--off);font-style:italic}
  .arrow{color:var(--faint);font-family:var(--mono)}
  .transfo{display:grid;grid-template-columns:1fr;gap:8px;margin-top:8px}
  .transfo-row{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;background:var(--panel2);
    border:1px solid var(--border-soft);border-radius:8px;padding:10px 14px;font-size:13px}
  .transfo-row .cat{font-family:var(--display);font-variant:small-caps;font-size:12.5px;color:var(--faint);min-width:150px}
  .transfo-row .big-arrow{font-family:var(--mono);color:var(--t3);font-size:15px}
  .strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px;margin:14px 0}
  .stat-card{background:var(--panel);border:1px solid var(--border-soft);border-radius:var(--radius);padding:13px 16px}
  .stat-card .num{font-family:var(--display);font-size:25px;color:var(--t3);line-height:1.1}
  .stat-card .lbl{color:var(--muted);font-size:11.5px;margin-top:3px}
  ul.clean{list-style:none;padding-left:0}
  ul.clean li{padding:5px 0 5px 20px;position:relative}
  ul.clean li::before{content:"◆";position:absolute;left:0;top:6px;font-size:9px;color:var(--t3)}
  details.acc{border:1px solid var(--border-soft);border-radius:9px;background:var(--panel2);margin:7px 0;overflow:hidden}
  details.acc summary{cursor:pointer;padding:10px 14px;font-weight:600;font-size:13.5px;list-style:none;display:flex;align-items:center;gap:8px}
  details.acc summary::before{content:"›";font-family:var(--mono);color:var(--t3);transition:transform .15s}
  details.acc[open] summary::before{transform:rotate(90deg)}
  details.acc summary::-webkit-details-marker{display:none}
  details.acc summary:focus-visible{outline:2px solid var(--t3);outline-offset:-2px}
  details.acc .acc-body{padding:0 14px 12px 32px;color:var(--muted);font-size:13px}
  .footer-note{margin-top:34px;padding-top:14px;border-top:1px solid var(--border-soft);color:var(--faint);font-size:12px}

  /* ── Dialogue de création ── */
  .overlay{position:fixed;inset:0;background:rgba(10,8,14,.7);backdrop-filter:blur(3px);z-index:80;
    display:flex;align-items:flex-start;justify-content:center;padding:6vh 16px;overflow-y:auto}
  .overlay[hidden]{display:none}
  .dlg{background:var(--panel);border:1px solid var(--border);border-radius:14px;padding:22px 24px;
    width:min(860px,100%);animation:pop .18s ease}
  @keyframes pop{from{transform:translateY(8px);opacity:0}to{transform:none;opacity:1}}
  .dlg h3{font-family:var(--display);font-variant:small-caps;letter-spacing:.05em;font-size:19px;font-weight:600;margin-bottom:12px}
  .ap-row{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:12px}
  .ap-row label{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:13px}
  .ap-row input[type=text]{background:var(--panel2);border:1px solid var(--border);border-radius:7px;color:var(--ink);padding:7px 11px;font:inherit;min-width:230px}
  .ap-row select{background:var(--panel2);border:1px solid var(--border);border-radius:7px;color:var(--ink);padding:7px 9px;font:inherit}
  .ap-grp{margin:10px 0}
  .grp-label{display:block;font-family:var(--display);font-variant:small-caps;letter-spacing:.04em;font-size:13px;color:var(--faint);margin-bottom:5px}
  .chip.pick{cursor:pointer}
  .chip.pick:not(.sel){opacity:.32;border-style:dashed;background:transparent}
  .ap-actions{display:flex;align-items:center;gap:10px;margin-top:16px;flex-wrap:wrap}
  .ap-warn{color:var(--off);font-family:var(--mono);font-size:12px}
  .ap-hint{color:var(--faint);font-size:12px;margin-top:10px}

  /* ── Toasts ── */
  #toasts{position:fixed;right:18px;bottom:18px;display:flex;flex-direction:column;gap:8px;z-index:100;max-width:min(380px,90vw)}
  .toast{background:var(--panel2);border:1px solid var(--border);border-left:3px solid var(--t3);border-radius:10px;
    padding:11px 14px;font-size:13px;display:flex;align-items:center;gap:12px;box-shadow:0 8px 24px rgba(0,0,0,.45);
    animation:tin .2s ease}
  @keyframes tin{from{transform:translateY(8px);opacity:0}to{transform:none;opacity:1}}
  .toast.out{opacity:0;transform:translateY(6px);transition:all .25s}
  .toast button{appearance:none;background:none;border:none;color:var(--t3);font-family:var(--mono);font-size:12px;
    cursor:pointer;text-decoration:underline dotted;padding:0;flex:0 0 auto}
  .toast button:focus-visible{outline:2px solid var(--t3);outline-offset:2px}

  /* ── Impression ── */
  #print-view{display:none}
  @media print{
    .app,#toasts,.overlay{display:none!important}
    body{background:#fff!important}
    #print-view{display:block;color:#111;font-family:Georgia,"Times New Roman",serif;font-size:11pt;line-height:1.45}
    #print-view h1{font-size:16pt;font-variant:small-caps;letter-spacing:.04em;margin:0 0 2pt;font-weight:600}
    #print-view .pv-meta{font-size:9pt;color:#555;margin-bottom:12pt}
    #print-view h2{font-size:12.5pt;font-variant:small-caps;letter-spacing:.03em;border-bottom:1pt solid #999;
      margin:14pt 0 8pt;padding-bottom:2pt;break-after:avoid;font-weight:600}
    #print-view .pv-rule{break-inside:avoid;border-left:2.5pt solid #b58a2e;padding:3pt 0 3pt 10pt;margin:0 0 9pt}
    #print-view .pv-rule.t1{border-left-color:#4a7fae}
    #print-view .pv-rule.perso{border-left-color:#7d57b5}
    #print-view .pv-title{font-weight:bold;font-size:11.5pt}
    #print-view .pv-mod{font-size:8pt;color:#8a6d1f;font-weight:normal;margin-left:8pt;text-transform:uppercase;letter-spacing:.07em}
    #print-view .pv-line{margin:1.5pt 0}
    #print-view .pv-k{color:#555;font-size:8.5pt;text-transform:uppercase;letter-spacing:.05em}
    #print-view .pv-warn{color:#a33;font-size:9.5pt;font-weight:normal}
    #print-view .pv-foot{margin-top:14pt;padding-top:6pt;border-top:1pt solid #999;font-size:9pt;color:#444}
    @page{margin:14mm}
  }

  /* ── Responsive ── */
  @media(max-width:920px){
    .app{grid-template-columns:1fr;height:auto;min-height:100vh}
    aside.side{flex-direction:row;flex-wrap:wrap;align-items:center;border-right:none;border-bottom:1px solid var(--border-soft);
      padding:12px 14px;gap:10px;position:sticky;top:0;z-index:40;overflow:visible}
    .brand{padding:0;margin-right:6px}
    nav.mainnav{flex-direction:row;gap:4px;overflow-x:auto}
    .nav-btn{border-left:none;border-bottom:2px solid transparent;border-radius:8px 8px 0 0;padding:7px 11px}
    .nav-btn.active{border-left:none;border-bottom-color:var(--t3)}
    .side-foot{margin:0 0 0 auto;border-top:none;padding:0;flex-direction:row;align-items:center;gap:12px}
    .prog-wrap{min-width:120px}
    .save-line{display:none}
    main#view{padding:20px 14px 70px;overflow:visible}
    .row-body{padding-left:16px}
    .row-mains{display:none}
    .minis{display:none}
  }
</style>
