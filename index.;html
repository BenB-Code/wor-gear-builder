function setChip(name){ const t=SETTIER[name]??0; return `<span class="chip set t${t}">${esc(name)}</span>`; }
function gauge(req){
  let d=""; for(let i=0;i<4;i++) d+=`<span class="dot${i<req?' fill':''}"></span>`;
  return `<span class="dots" aria-label="${req} subs requis sur 4">${d}</span>`;
}
function copyText(r){
  const st=S[r.id];
  return `${r.id} · ${r.name}\nSets : ${r.sets.join(", ")}\nAttribut(s) principal(aux) : ${r.mains.join(" / ")||"—"}\nPool de secondaires : ${sortStats(st.pool).join(", ")||"—"}\nNombre requis : ${st.req}\nEssentiels : ${sortStats(st.ess).join(", ")||"—"}`;
}
function ruleClass(r){
  if(isCustom(r.id)) return "perso";
  return sectionOf(r.id)==="t1" ? "s-t1" : "";
}
function ruleRow(r){
  const st = S[r.id];
  const open = UI.open.has(r.id);
  const mains = r.mains.length ? r.mains.map(m=>`<span class="main-or">${m}</span>`).join('<span class="main-or sep">/</span>') : '<span class="main-or">—</span>';
  const minis = sortStats(st.pool).map(a=>`<span class="mini${st.ess.includes(a)?' e':''}">${st.ess.includes(a)?"★":""}${a}</span>`).join("");
  const chips = ALLSTATS.filter(a=>!r.mains.includes(a)).map(a=>{
    const inPool = st.pool.includes(a), inEss = st.ess.includes(a);
    const state = inEss ? "ess" : (inPool ? "" : "stateoff");
    return `<button type="button" class="chip ${STAT[a]} ${state} tog" data-rule="${r.id}" data-stat="${a}" aria-pressed="${inPool}" title="${a} : ${inEss?'essentiel':(inPool?'dans le pool':'hors pool')}">${inEss?"★ "+a:a}</button>`;
  }).join("");
  let warn = "";
  if(st.ess.length > st.req) warn = `<span class="rc-warn">★ &gt; requis</span>`;
  else if(st.req > st.pool.length) warn = `<span class="rc-warn">requis &gt; pool</span>`;
  const custom = isCustom(r.id);
  return `<article class="rule ${ruleClass(r)}${open?' open':''}" id="card-${r.id}">
    <div class="row-head" role="button" tabindex="0" aria-expanded="${open}" data-toggle="${r.id}">
      <input type="checkbox" class="chk" data-entered="${r.id}" ${ENTERED.has(r.id)?"checked":""} title="saisie en jeu" aria-label="règle saisie en jeu">
      <span class="rc-id">${r.id}</span>
      <span class="rc-name">${esc(r.name)}${custom?'<span class="custom-tag">perso</span>':''}${isModified(r.id)?'<span class="mod-dot" title="modifiée par rapport aux défauts"></span>':''}</span>
      <span class="row-mains">${r.mains.join(" / ")||"—"}</span>
      <span class="row-right">
        <span class="minis">${minis}</span>
        ${gauge(st.req)}
        <svg class="chev" width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6l5 5 5-5"/></svg>
      </span>
    </div>
    <div class="row-body">
      <div class="rc-sets" style="margin-top:10px">${r.sets.map(setChip).join("")}</div>
      <div class="rb-grid">
        <span class="k">Main(s)</span><span>${mains}</span>
        <span class="k">Subs</span><span>${chips}</span>
        <span class="k">Requis</span><span><span class="stepper"><button type="button" class="st-minus" data-rule="${r.id}" aria-label="réduire">−</button><span class="val">${st.req}</span><button type="button" class="st-plus" data-rule="${r.id}" aria-label="augmenter">+</button></span>${warn}</span>
      </div>
      ${r.note?`<div class="rb-note">${r.note}</div>`:""}
      <div class="rb-actions">
        <button type="button" class="sbtn rc-copy" data-rule="${r.id}">copier</button>
        ${custom?"":`<button type="button" class="sbtn rc-reset" data-rule="${r.id}">défauts</button>`}
        <button type="button" class="sbtn del rc-del" data-rule="${r.id}">supprimer</button>
      </div>
    </div>
  </article>`;
}

