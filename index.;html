function matchFilters(r){
  if(UI.fSection!=="all" && sectionOf(r.id)!==UI.fSection) return false;
  if(UI.fArch!=="all" && !(r.arch||[]).includes(UI.fArch)) return false;
  if(UI.q){
    const q = UI.q.toLowerCase();
    const hay = (r.id+" "+r.name+" "+r.sets.join(" ")+" "+r.mains.join(" ")+" "+(r.arch||[]).map(a=>ARCH_LABEL[a]).join(" ")).toLowerCase();
    if(!hay.includes(q)) return false;
  }
  return true;
}
