const SECTIONS = ["right","left","t1"];
const SECTION_LABEL = {right:"Côté droit · T2/T3", left:"Côté gauche · T2/T3", t1:"T1 · Quad transformation"};
const ARCH_LABEL = {dps:"DPS", tank:"Tank", heal:"Heal", support:"Support", inspire:"Inspire"};

/* ══════════════ ÉTAT ══════════════ */
const BUILTIN = [...RULES.right, ...RULES.left, ...RULES.t1];
const DEFAULTS = Object.fromEntries(BUILTIN.map(r=>[r.id,{pool:[...r.pool],ess:[...r.ess],req:r.req}]));
let S = JSON.parse(JSON.stringify(DEFAULTS));
let DELETED = new Set();
let CUSTOM = [];            // {id, name, section, sets, mains, arch:[]}
let ENTERED = new Set();    // règles saisies dans le jeu
let customSeq = 1;
const KEY = "wor-tri-rules-v1";

const UI = { view:"regles", seg:"pre", q:"", fSection:"all", fArch:"all",
             open:new Set(), setsQ:"", setsTier:"all", pending:null };

function getRule(id){ return BUILTIN.find(r=>r.id===id) || CUSTOM.find(r=>r.id===id) || null; }
function sectionOf(id){
  for(const sec of SECTIONS) if(RULES[sec].some(r=>r.id===id)) return sec;
  const c = CUSTOM.find(r=>r.id===id); return c ? c.section : "right";
}
function isCustom(id){ return CUSTOM.some(r=>r.id===id); }
function activeAll(){ return [...BUILTIN.filter(r=>!DELETED.has(r.id)), ...CUSTOM]; }
function activeList(sec){ return [...RULES[sec].filter(r=>!DELETED.has(r.id)), ...CUSTOM.filter(r=>r.section===sec)]; }
function isModified(id){
  const d = DEFAULTS[id]; if(!d) return false;
  const a = S[id];
  return a.req!==d.req || a.pool.join()!==d.pool.join() || a.ess.join()!==d.ess.join();
}
function sortStats(arr){ return ALLSTATS.filter(x=>arr.includes(x)); }
function sortSets(arr){ return [...arr].sort((a,b)=>(SETTIER[b]??0)-(SETTIER[a]??0) || a.localeCompare(b)); }
function esc(s){ return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }

/* ══════════════ PERSISTANCE ══════════════ */
let saveTimer = null;
function setSave(txt, cls){
  const line = document.getElementById("save-line");
  const st = document.getElementById("save-status");
  if(st) st.textContent = txt;
  if(line){ line.className = "save-line" + (cls?" "+cls:""); }
}
function payload(){ return JSON.stringify({v:3, rules:S, deleted:[...DELETED], custom:CUSTOM, seq:customSeq, entered:[...ENTERED]}); }
async function persist(){
  if(!window.storage || !window.storage.set){ setSave("session seule","warn"); return; }
  try{ await window.storage.set(KEY, payload()); setSave("enregistré","ok"); }
  catch(e){ setSave("session seule","warn"); }
}
function scheduleSave(){ clearTimeout(saveTimer); saveTimer = setTimeout(persist, 600); }
async function restoreState(){
  if(!window.storage || !window.storage.get) { setSave("session seule","warn"); return; }
  try{
    const r = await window.storage.get(KEY);
    if(!r || !r.value) { setSave("prêt","ok"); return; }
    const data = JSON.parse(r.value);
    const rules = (data && data.v>=2) ? (data.rules||{}) : (data||{});
    if(data && data.v>=2){
      if(Array.isArray(data.custom)){
        for(const c of data.custom){
          if(!c || typeof c.id!=="string" || getRule(c.id)) continue;
          CUSTOM.push({
            id:c.id, name:String(c.name||c.id).slice(0,60),
            section:SECTIONS.includes(c.section)?c.section:"right",
            sets:Array.isArray(c.sets)?c.sets.filter(x=>SETTIER[x]!==undefined):[],
            mains:Array.isArray(c.mains)?c.mains.filter(x=>ALLSTATS.includes(x)):[],
            arch:Array.isArray(c.arch)?c.arch.filter(a=>ARCH_LABEL[a]):[]
          });
          S[c.id] = {pool:[],ess:[],req:3};
        }
      }
      if(Array.isArray(data.deleted)) data.deleted.forEach(id=>{ if(DEFAULTS[id]) DELETED.add(id); });
      if(Array.isArray(data.entered)) data.entered.forEach(id=>ENTERED.add(id));
      if(Number.isInteger(data.seq)) customSeq = Math.max(customSeq, data.seq);
    }
    for(const id in rules){
      if(!S[id]) continue;
      const d = rules[id], rule = getRule(id);
      if(Array.isArray(d.pool)) S[id].pool = d.pool.filter(x=>ALLSTATS.includes(x) && !(rule && rule.mains.includes(x)));
      if(Array.isArray(d.ess))  S[id].ess  = d.ess.filter(x=>S[id].pool.includes(x));
      if(Number.isInteger(d.req)) S[id].req = Math.min(4, Math.max(1, d.req));
    }
    setSave("restauré","ok");
  }catch(e){ setSave("session seule","warn"); }
  renderView(); updateSidebar();
}

/* ══════════════ TOASTS ══════════════ */
function toast(msg, opts={}){
  const box = document.getElementById("toasts");
  const el = document.createElement("div");
  el.className = "toast";
  el.innerHTML = `<span>${msg}</span>` + (opts.action?`<button type="button">${esc(opts.action.label)}</button>`:"");
  if(opts.action){
    el.querySelector("button").addEventListener("click", ()=>{ opts.action.fn(); dismiss(); });
  }
  box.appendChild(el);
  let gone = false;
  function dismiss(){ if(gone) return; gone = true; el.classList.add("out"); setTimeout(()=>el.remove(), 280); }
  setTimeout(dismiss, opts.ttl||5500);
}

